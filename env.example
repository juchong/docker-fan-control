# Docker Fan Control — configuration
# Copy to .env and customize. All values are optional except AUTH_JWT_SECRET
# (when auth is enabled). Defaults are shown.

TZ=America/Los_Angeles

# ── Authentication ──────────────────────────────────────────────────────────
AUTH_ENABLED=true

# REQUIRED when auth is enabled. The backend refuses to start with the default
# placeholder below. Generate one with:  openssl rand -hex 32
AUTH_JWT_SECRET=change-me-in-production

AUTH_TOKEN_TTL=24h

# Initial admin, created on first run only.
AUTH_DEFAULT_ADMIN=admin
AUTH_DEFAULT_PASSWORD=admin

# Reset the admin password to AUTH_DEFAULT_PASSWORD on next start, then set back
# to false.
AUTH_RESET_ADMIN_PASSWORD=false

# Reverse-proxy auth (Authelia/Authentik/etc). When enabled, the proxy-supplied
# user header is trusted. Only enable behind a proxy that actually sets it.
AUTH_PROXY_ENABLED=false
AUTH_PROXY_HEADER=X-Forwarded-User
AUTH_PROXY_AUTO_CREATE=true

# ── Fan control backend ─────────────────────────────────────────────────────
# hwmon (BMC-less boards): optional comma-separated allow-list of Super-I/O
# chip-name prefixes to bind (e.g. "it87952"); empty binds every Nuvoton
# (nct6*) / ITE (it8*) chip that exposes PWM channels. Requires a read-write
# /sys mount and apparmor=unconfined on the container (see README).
HWMON_CHIP=

# IPMI (BMC servers): "local" uses /dev/ipmi0; "lan" needs the host/user/pass.
IPMI_MODE=local
# IPMI_HOST=192.168.1.100
# IPMI_USER=admin
# IPMI_PASS=password

# Control-loop interval.
CONTROL_INTERVAL=5s

# ── Networking / security ───────────────────────────────────────────────────
# CIDRs whose X-Forwarded-For is trusted for per-client rate limiting — set this
# to your reverse proxy's subnet, otherwise every client collapses to the proxy
# IP (or spoofable headers are believed). Empty = trust none.
# TRUSTED_PROXIES=172.19.0.0/16

# Extra cross-origin origins allowed for the API/WebSocket (comma-separated).
# Same-origin is always allowed, so this is only needed for cross-origin embeds.
# ALLOWED_ORIGINS=https://fancontrol.example.com

# ── Misc ────────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info

# SERVER_PORT=8080
# DATA_PATH=/app/data
