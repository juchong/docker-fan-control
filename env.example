# Docker Fan Control Configuration
# Copy this file to .env and customize

# Timezone
TZ=America/Los_Angeles

# Frontend port (web UI)
FRONTEND_PORT=3000

# IPMI Mode: "local" for /dev/ipmi0, "lan" for network access
IPMI_MODE=local

# IPMI LAN settings (only needed if IPMI_MODE=lan)
# IPMI_HOST=192.168.1.100
# IPMI_USER=admin
# IPMI_PASS=password

# Authentication
AUTH_ENABLED=true

# IMPORTANT: Generate a secure secret for production!
# Run: openssl rand -hex 32
AUTH_JWT_SECRET=change-me-in-production

# Token expiration (e.g., 24h, 7d, 168h)
AUTH_TOKEN_TTL=24h

# Default admin credentials (change password after first login!)
AUTH_DEFAULT_ADMIN=admin
AUTH_DEFAULT_PASSWORD=admin

# Reverse proxy authentication (optional)
AUTH_PROXY_ENABLED=false
AUTH_PROXY_HEADER=X-Forwarded-User

# Fan control loop interval
CONTROL_INTERVAL=5s
